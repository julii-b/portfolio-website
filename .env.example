# 'dev' or 'prod':
NEXT_PUBLIC_ENV=dev

# Keys for Cloudflare Turnstile CAPTCHA; obtain from Cloudflare dashboard > 'Protect & Connect' > 'Turnstile':
NEXT_PUBLIC_TURNSTILE_SITE_KEY=***** #change this
TURNSTILE_SECRET_KEY=***** #change this

# SMTP server configuration to send emails:
SMTP_HOST=smtp.example.com #change this
SMTP_PORT=465
SMTP_USER=mail@example.com #change this
SMTP_PASSWORD=***** #change this

# API key for Gemma API; used for Gemini integration; obtain from Google AI Studio > 'API keys':
GEMMA_API_KEY=***** #change this